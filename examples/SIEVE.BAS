100 REM SIEVE OF ERATOSTHENES
110 HOME
120 INPUT "LIMIT? ";LI
130 DIM N(LI)
140 SL = SQR(LI)
150 N(0) = 1 : N(1) = 1
160 FOR P = 2 TO SL
170   IF N(P) THEN 210
180   FOR I = P*P TO LI STEP P
190     N(I) = 1
200   NEXT I
210 NEXT P
220 FOR I = 2 TO LI
230   IF N(I) = 0 THEN PRINT I,
240 NEXT I
250 PRINT
