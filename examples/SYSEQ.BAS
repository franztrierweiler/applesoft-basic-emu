10  REM SYSTEME D'EQUATIONS LINEAIRES
20  REM METHODE DES ADDITIONS - MODE TEXTE PUR
30  TEXT : HOME
40  INVERSE
50  PRINT " RESOLUTION DE SYSTEME LINEAIRE         "
60  NORMAL : PRINT
70  PRINT "METHODE DES ADDITIONS (PIVOT DE GAUSS)"
80  PRINT
90  INPUT "NOMBRE D'INCONNUES (2-4) ? ";N
100 IF N < 2 THEN 90
110 IF N > 4 THEN 90
120 NC = N + 1
130 DIM A(N,NC),X(N),Y(N + 1)
140 REM SOLUTION CACHEE (-3..3 NON NULLE)
150 FOR I = 1 TO N
160   X(I) = INT (RND (1) * 7) - 3
170   IF X(I) = 0 THEN X(I) = 2
180 NEXT I
190 REM COEFFICIENTS RANDOM (-4..4 DIAGONALE NON NULLE)
200 FOR I = 1 TO N
210   FOR J = 1 TO N
220     A(I,J) = INT (RND (1) * 9) - 4
230     IF I = J AND A(I,J) = 0 THEN A(I,J) = 1
240   NEXT J
250 NEXT I
260 REM SECONDS MEMBRES B(I) = SOMME A(I,J) * X(J)
270 FOR I = 1 TO N
280   S = 0
290   FOR J = 1 TO N : S = S + A(I,J) * X(J) : NEXT J
300   A(I,NC) = S
310 NEXT I
320 REM AFFICHAGE INITIAL DU SYSTEME
330 HOME
340 INVERSE : PRINT "SYSTEME INITIAL " : NORMAL : PRINT
350 GOSUB 900
360 PRINT
370 PRINT "(SOLUTION CACHEE - A RETROUVER)"
380 PRINT
390 PRINT "PRESSEZ UNE TOUCHE POUR DEMARRER..."
400 GET K$
410 REM PHASE 1 : ELIMINATION DESCENDANTE
420 FOR P = 1 TO N - 1
430   GOSUB 980 : REM PIVOT PARTIEL SI A(P,P) = 0
440   FOR R = P + 1 TO N
450     IF A(R,P) = 0 THEN 560
460     MP = A(P,P) : MR = A(R,P)
470     HOME
480     INVERSE : PRINT "PHASE 1 : ELIMINATION " : NORMAL : PRINT
490     PRINT "ETAT COURANT :" : PRINT
500     GOSUB 900 : PRINT
510     PRINT "FACTEURS UTILISES :"
520     PRINT "  MP = ";MP;"  (PIVOT  : A(";P;",";P;"))"
530     PRINT "  MR = ";MR;"  (CIBLE  : A(";R;",";P;"))"
540     PRINT
550     PRINT "OPERATION : L";R;" <- (";MP;") * L";R;" - (";MR;") * L";P
552     FOR C = P TO NC
554       A(R,C) = MP * A(R,C) - MR * A(P,C)
556     NEXT C
558     GOSUB 800 : REM PAUSE 1 SECONDE
560   NEXT R
570 NEXT P
580 HOME
590 INVERSE : PRINT "MATRICE TRIANGULARISEE  " : NORMAL : PRINT
600 GOSUB 900 : PRINT
610 PRINT "PHASE 2 : REMONTEE PAR SUBSTITUTION"
620 GOSUB 800
630 REM PHASE 2 : SUBSTITUTION REMONTANTE
640 FOR I = N TO 1 STEP -1
650   S = A(I,NC)
660   FOR J = I + 1 TO N
670     S = S - A(I,J) * Y(J)
680   NEXT J
690   IF A(I,I) = 0 THEN PRINT "SYSTEME SINGULIER" : END
700   Y(I) = S / A(I,I)
710 NEXT I
720 HOME
730 INVERSE : PRINT "SOLUTION                " : NORMAL : PRINT
740 FOR I = 1 TO N
750   PRINT "  ";CHR$ (64 + I);" = ";Y(I)
760 NEXT I
770 PRINT
780 PRINT "VERIFICATION (SOLUTION CACHEE) :"
790 FOR I = 1 TO N
792   PRINT "  ";CHR$ (64 + I);" = ";X(I)
794 NEXT I
796 END
800 REM ----------------------------------------
805 REM SOUS-PROG : PAUSE ~1 SECONDE
810 FOR D = 1 TO 1000 : NEXT D
820 RETURN
880 REM ----------------------------------------
890 REM SOUS-PROG : AFFICHAGE DE LA MATRICE
900 FOR I = 1 TO N
910   FOR J = 1 TO N
920     IF A(I,J) >= 0 THEN PRINT "+";
930     PRINT A(I,J);CHR$ (64 + J);" ";
940   NEXT J
950   PRINT "= ";A(I,NC)
960 NEXT I
970 RETURN
975 REM ----------------------------------------
976 REM SOUS-PROG : PIVOT PARTIEL SI A(P,P) = 0
980 IF A(P,P) <> 0 THEN RETURN
990 FOR R2 = P + 1 TO N
1000  IF A(R2,P) = 0 THEN 1040
1010  FOR C2 = 1 TO NC
1020    T = A(P,C2) : A(P,C2) = A(R2,C2) : A(R2,C2) = T
1030  NEXT C2 : RETURN
1040 NEXT R2
1050 RETURN
